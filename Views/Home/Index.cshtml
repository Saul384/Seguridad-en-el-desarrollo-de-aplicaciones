@model List<VulnerableApp.Models.User>

<div class="text-center">
    <h1 class="display-4">Buscador de Usuarios</h1>
</div>

<div class="row mt-4">
    <div class="col-md-6 offset-md-3">
        <form method="get" action="/Home/Index">
            <div class="input-group mb-3">
                <input type="text" name="search" class="form-control" placeholder="Buscar por Username..." />
                <button class="btn btn-primary" type="submit">Buscar</button>
            </div>
        </form>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-8 offset-md-2">
        @if (Model != null && Model.Count > 0)
        {
            <table class="table table-bordered table-striped">
                <thead class="thead-dark">
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.Username</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info text-center">
                Realiza una búsqueda o no se encontraron resultados.
            </div>
        }
    </div>
</div>