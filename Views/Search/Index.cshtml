@model IEnumerable<VulnerableApp.Models.User>

<h2>Buscar Usuarios</h2>

<form method="get">
    <input type="text" name="search" placeholder="Busca usuario..." />
    <button type="submit">Buscar</button>
</form>

@if (Model?.Any() == true)
{
    <table border="1" style="margin-top: 20px; border-collapse: collapse;">
        <tr>
            <th style="padding: 5px;">Username</th>
            <th style="padding: 5px;">Email</th>
            <th style="padding: 5px;">Balance</th>
        </tr>
        @foreach (var user in Model)
        {
            <tr>
                <td style="padding: 5px;">@user.Username</td>
                <td style="padding: 5px;">@user.Email</td>
                <td style="padding: 5px;">$@user.Balance</td>
            </tr>
        }
    </table>
}